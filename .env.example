# Copie ce fichier vers ".env" et remplis tes propres valeurs.
# Ne partage JAMAIS ton fichier .env (il contient des clés secrètes).

# Clé secrète Stripe — Dashboard Stripe > Développeurs > Clés API
# Commence par "sk_test_" en mode test, "sk_live_" en mode réel.
STRIPE_SECRET_KEY=sk_test_...

# Secret de signature du webhook — donné par `stripe listen` en local,
# ou par le Dashboard Stripe > Développeurs > Webhooks en production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Prix de l'inscription en euros (ex: 25 ou 25.00)
PRICE_EUR=25

# Nom affiché sur la page et sur le reçu Stripe
PRODUCT_NAME=Frais d'inscription

# URL publique de ton site (utilisée pour les redirections après paiement).
# En local : http://localhost:4242
# En production : https://ton-site.exemple.com
DOMAIN=http://localhost:4242

# Port d'écoute du serveur (optionnel)
PORT=4242

# --- Liaison avec le site Patro (inscriptions) ---
# URL du site principal (PHP), pour que ce serveur puisse marquer une
# inscription comme "payee" une fois le paiement confirme par Stripe, et
# pour rediriger la personne vers ce site apres paiement (voir succes.html).
# IMPORTANT : doit correspondre EXACTEMENT a l'adresse utilisee dans le
# navigateur pour acceder au site Patro (meme protocole, meme hote), sinon
# le cookie de session ne suit pas et la personne se retrouve deconnectee en
# revenant sur le site apres avoir paye. "localhost" et "127.0.0.1" sont deux
# hotes DIFFERENTS pour un navigateur (meme regle en production entre
# "exemple.be" et "www.exemple.be", ou http vs https) : mets ici exactement
# ce que la barre d'adresse affiche quand tu utilises le site.
# En local : http://127.0.0.1:8080 (ou http://localhost:8080 si c'est
# vraiment cette adresse-la que tu utilises pour ouvrir le site)
PATRO_SITE_URL=http://127.0.0.1:8080

# Secret partage avec mark_paid.php (site principal) pour verifier que la
# requete vient bien de ce serveur de paiement. Genere une valeur aleatoire
# et mets EXACTEMENT LA MEME dans public - Copie/.env (ou en dur dans
# mark_paid.php si tu ne veux pas gerer un fichier .env sur le site PHP).
PATRO_WEBHOOK_SECRET=change-moi
